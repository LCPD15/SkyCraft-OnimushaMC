{
  "schemaVersion": 1,
  "id": "skycraft",
  "version": "${version}",
  "name": "SkyCraft: Onimusha MC",
  "description": "Onimusha REFramework bridge: Minecraft controls, combat, HUD, items and colliding blocks. Native HP is shown as ten percentage-based hearts. Experimental; native terrain is protected.",
  "authors": ["chasmlol (SkyCraft)", "LCPD15/LCPD拉灯 (Onimusha adaptation)"],
  "contact": {
    "sources": "https://github.com/LCPD15/SkyCraft-OnimushaMC"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": ["dev.skycraft.SkyCraft"],
    "client": ["dev.skycraft.client.SkyCraftClient"]
  },
  "mixins": [
    "skycraft.mixins.json",
    { "config": "skycraft.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
